# Copy to config.env, fill required paths, and pass CONFIG_FILE explicitly:
# CONFIG_FILE="$PWD/config.env" bash evaluation/run.sh all bagel
# Use absolute paths so commands work from outside the repository.
# Verified Hugging Face commits and download/extraction commands:
# README.md#download-resources and each workflow's README.

# Each interpreter belongs to a prepared model/metric environment.
PYTHON_BIN=python
BAGEL_PYTHON=python
EVAL_PYTHON=python
CLIP_DINO_PYTHON=python
QWEN_VL_PYTHON=python
VGGT_PYTHON=python

# Preprocessed source datasets (RGB and sensor-depth images).
# Both published datasets extract under resources/data/<dataset>.
# Example: SCANNET_ROOT="/absolute/path/MindView/resources/data/scannet"
SCANNET_ROOT=""
SCANNETPP_ROOT=""
ARKITSCENES_ROOT=""
DATA_SPLIT=val

# BAGEL base-model assets and trained EMA checkpoint.
# Download the complete pinned base snapshot described in sft/README.md.
# Published BF16 EMA: wangyanbo/MindView-BAGEL-SFT at the revision in sft/README.md.
BAGEL_MODEL_PATH=""
BAGEL_SFT_FINAL_CHECKPOINT=""

# Separately supplied frozen 20,000-example, six-view SFT JSONL.
# Download wangyanbo/MindView-Train at the commit pinned in README.md.
# Example: TRAINING_JSONL="/absolute/path/MindView/resources/MindView-Train/data/train.jsonl"
TRAINING_JSONL=""
SFT_NPROC_PER_NODE=8
SFT_NNODES=1
SFT_NODE_RANK=0
MASTER_ADDR=127.0.0.1
MASTER_PORT=29500

# Three understanding benchmarks (see understanding/README.md).
SAT_V2_PARQUET=""
MMSI_PARQUET=""
MINDCUBE_DATA_ROOT=""
# Optional: UNDERSTANDING_OUTPUT_ROOT="/absolute/path/to/outputs/understanding"
# Downloads are opt-in via understanding/run.sh --allow-download (SAT/MMSI only).
# test_single_gpu.sh fixes one process and uses its own isolated output directories.

# Optional overrides. Defaults are derived from the repository location.
# OUTPUTS_ROOT="/absolute/path/to/outputs"
# GENERATION_ROOT="/absolute/path/to/outputs/generations"
# METRICS_ROOT="/absolute/path/to/outputs/metrics"
# REPORT_ROOT="/absolute/path/to/outputs/reports"
# SFT_OUTPUT_ROOT="/absolute/path/to/outputs/sft"
# INPUT_JSON="/absolute/path/to/evaluation/data/merged_dataset_final.jsonl"
# For official C6-only evaluation, use the following three settings together:
# INPUT_JSON="/absolute/path/MindView/resources/MindView-Bench/data/test.jsonl"
# VGGT_CANONICAL_JSON="/absolute/path/MindView/resources/MindView-Bench/context_scaling/metadata.jsonl"
# REPORT_PROTOCOL=selected

NUM_GPUS=1
OVERWRITE=0
SKIP_COMPLETED=1
